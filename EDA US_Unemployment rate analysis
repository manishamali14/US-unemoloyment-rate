    data = json.load(file)\n","\n","\n","# Convert Nested JSON into dataframe \n","\n","rows = []\n","\n","for year, periods in data.items():\n","\n","    for month, states in periods.items():\n","\n","        if month == \"Annual\":\n","            continue\n","\n","        for state, metrics in states.items():\n","\n","            unemployment_data = metrics.get(\"Unemployment Rate\", {})\n","\n","            for county, rate in unemployment_data.items():\n","\n","                rows.append([\n","                    year,month,state,county,rate\n","                ])\n","\n","\n","df = pd.DataFrame(\n","    rows,\n","    columns=[\n","        \"Year\",\"Month\",\"State\",\"County\",\"UnemploymentRate\"\n","    ]\n",")\n","\n","print(\"Dataset loaded successfully\")\n","print(\"Initial shape:\", df.shape)\n","\n","# Standardize column names \n","\n","df.columns = (\n","    df.columns\n","    .str.strip()\n","    .str.replace(\" \", \"_\")\n",")\n","\n","print(\"\\nColumn names:\")\n","print(df.columns.tolist())\n","\n","# Remove extra spaces from text columns\n","\n","text_columns = [\"Month\", \"State\", \"County\"]\n","\n","for col in text_columns:\n","    df[col] = df[col].astype(\"string\").str.strip()\n","\n","# Check missing values before type conversion\n","\n","print(\"\\nMissing values before cleaning:\")\n","print(df.isnull().sum())\n","\n","# Convert data types\n","\n","df[\"Year\"] = pd.to_numeric(\n","    df[\"Year\"],\n","    errors=\"coerce\"\n",")\n","\n","df[\"UnemploymentRate\"] = pd.to_numeric(\n","    df[\"UnemploymentRate\"],\n","    errors=\"coerce\"\n",")\n","\n","# Check Invalid numeric valid\n","\n","print(\"\\nInvalid Year values:\",\n","      df[\"Year\"].isna().sum())\n","\n","print(\"Invalid UnemploymentRate values:\",\n","      df[\"UnemploymentRate\"].isna().sum())\n","\n","# Remove records with missing critical values\n","\n","df = df.dropna(\n","    subset=[\n","        \"Year\",\"Month\",\"State\",\"County\",\"UnemploymentRate\"\n","    ]\n",")\n","\n","# Convert year to integer\n","\n","df[\"Year\"] = df[\"Year\"].astype(\"int64\")\n","\n","# Check Valid month names \n","\n","MONTHS = [\n","    \"January\", \"February\", \"March\", \"April\",\n","    \"May\", \"June\", \"July\", \"August\",\n","    \"September\", \"October\", \"November\", \"December\"\n","]\n","\n","invalid_months = df.loc[\n","    ~df[\"Month\"].isin(MONTHS),\n","    \"Month\"\n","]\n","\n","print(\"\\nInvalid month values:\", invalid_months.nunique())\n","\n","if not invalid_months.empty:\n","    print(invalid_months.unique())\n","\n","# Create month number\n","\n","MONTH_NUM = {\n","    month: number\n","    for number, month in enumerate(MONTHS, start=1)\n","}\n","\n","df[\"MonthNum\"] = df[\"Month\"].map(MONTH_NUM)\n","\n","# Check for missing month numbers \n","\n","print(\n","    \"Missing MonthNum values:\",\n","    df[\"MonthNum\"].isna().sum()\n",")\n","\n","# Create Date column \n","\n","df[\"Date\"] = pd.to_datetime(\n","    {\n","        \"year\": df[\"Year\"],\n","        \"month\": df[\"MonthNum\"],\n","        \"day\": 1\n","    },\n","    errors=\"coerce\"\n",")\n","\n","# check invalid dates\n","\n","print(\n","    \"Invalid Date values:\",\n","    df[\"Date\"].isna().sum()\n",")\n","\n","# Check negative unemployment rates \n","\n","negative_rates = (\n","    df[\"UnemploymentRate\"] < 0\n",").sum()\n","\n","print(\n","    \"\\nNegative unemployment rates:\",\n","    negative_rates\n",")\n","\n","# Remove only if any exist\n","df = df[\n","    df[\"UnemploymentRate\"] >= 0\n","].copy()\n","\n","print(\"\\nUnemployment rate range:\")\n","print(\n","    \"Minimum:\",\n","    df[\"UnemploymentRate\"].min()\n",")\n","\n","print(\n","    \"Maximum:\",\n","    df[\"UnemploymentRate\"].max()\n",")\n","\n","print(\n","    \"Rates above 50%:\",\n","    (df[\"UnemploymentRate\"] > 50).sum()\n",")\n","\n","duplicate_rows = df.duplicated().sum()\n","\n","print(\"\\nDuplicate complete rows:\", duplicate_rows)\n","\n","duplicate_keys = df.duplicated(\n","    subset=[\n","        \"Year\",\"Month\",\"State\",\"County\"\n","    ]\n",").sum()\n","\n","print(\n","    \"Duplicate Year-Month-State-County records:\",\n","    duplicate_keys\n",")\n","\n","df = df.drop_duplicates(\n","    subset=[\n","        \"Year\",\"Month\",\"State\",\"County\"\n","    ]\n",").copy()\n","\n","print(\"\\nMissing values after cleaning:\")\n","print(df.isnull().sum())\n","print(\"\\nData types:\")\n","print(df.dtypes)\n","df = df.sort_values(\n","    by=[\n","        \"Date\",\"State\",\"County\"\n","    ]\n",").reset_index(drop=True)\n","\n","print(\"\\nFinal dataset shape:\")\n","print(df.shape)\n","\n","print(\"\\nFinal dataset information:\")\n","df.info()\n","print(\"\\nCleaned dataset:\")\n","display(df.head())\n"]},{"cell_type":"markdown","id":"d4659d43","metadata":{"papermill":{"duration":0.007231,"end_time":"2026-09-16T07:03:59.629974+00:00","exception":false,"start_time":"2026-09-16T07:03:59.622743+00:00","status":"completed"},"tags":[]},"source":["*The dataset was cleaned by removing extra spaces, checking missing values, correcting data types, removing duplicates and invalid unemployment rates, validating months, and creating a proper date column. No imputation was required because there were no missing values in the extracted records.*"]},{"cell_type":"markdown","id":"776a8d13","metadata":{"papermill":{"duration":0.007359,"end_time":"2026-09-16T07:03:59.644005+00:00","exception":false,"start_time":"2026-09-16T07:03:59.636646+00:00","status":"completed"},"tags":[]},"source":["**Calculate data coverage by state**"]},{"cell_type":"code","execution_count":3,"id":"716d238b","metadata":{"execution":{"iopub.execute_input":"2026-09-16T07:03:59.660032Z","iopub.status.busy":"2026-09-16T07:03:59.659165Z","iopub.status.idle":"2026-09-16T07:03:59.664998Z","shell.execute_reply":"2026-09-16T07:03:59.664135Z"},"papermill":{"duration":0.015787,"end_time":"2026-09-16T07:03:59.666788+00:00","exception":false,